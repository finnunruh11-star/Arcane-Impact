; Arcane Impact - clean-room Godot project.
; Edit through the Godot editor where practical; keep this file under version control.
config_version=5

[application]

config/name="Arcane Impact"
run/main_scene="res://scenes/roster_select.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.043, 0.055, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[layer_names]

2d_physics/layer_1="Player Body"
2d_physics/layer_2="Enemy Body"
2d_physics/layer_3="World"
2d_physics/layer_4="Player Attack"
2d_physics/layer_5="Enemy Hurtbox"
2d_physics/layer_6="Enemy Attack"
2d_physics/layer_7="Player Hurtbox"
2d_physics/layer_8="Combat Sensor"